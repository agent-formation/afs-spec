# HTTP-based MCP server configuration schema
schema: "1.0.0"                    # Schema version (Semantic Versioning)
id: "web-tools"                    # Unique server name/id (required)
description: "External web tools"  # Human-readable description
type: "http"                       # Server type: http (required)

# Connection details
endpoint: "https://external.com/mcp"  # Server endpoint URL (required)
timeout_seconds: 30                # Request timeout (overrides default)
retry_attempts: 3                  # Number of retry attempts (overrides default)
connection_ttl: 600                # Idle TTL override for this server (overrides mcp.connection_ttl)

# Authentication (optional)
auth:
  type: "bearer"                   # Auth type: bearer, basic, api_key, none
  token: "${{ secrets.MCP_TOKEN }}"            # Auth token (for bearer)
  # Alternative for basic auth:
  # username: "${{ secrets.MCP_USERNAME }}"
  # password: "${{ secrets.MCP_PASSWORD }}"

  # Alternative for API key:
  # header: "X-API-Key"
  # key: "${{ secrets.API_KEY }}"

# Default parameters (optional)
# Key-value pairs injected into every tool call on this server.
# Useful for org-wide constants (e.g. a fixed drive ID, tenant ID, project key)
# so the LLM never has to infer or propagate infrastructure values.
# Supports secret interpolation. Caller-provided values always take precedence.
parameters:
  driveId: "${{ secrets.ORG_DRIVE_ID }}"
  # tenantId: "${{ secrets.TENANT_ID }}"

# Tool filtering (optional)
# Restrict the upstream tool catalog at registration time. Use exactly one
# of whitelist or blacklist (declaring both is a load-time error).
# Patterns are POSIX fnmatch globs; literals match exactly. Reduces the
# per-turn planning prompt for catalogs the agent only partially needs.
tools:
  whitelist:
    - "search_*"            # any tool whose name starts with search_
    - "get_*"
    - "list_*"
    - "create_or_update_file"  # literal name, exact match
  # Alternatively, allow-everything-except destructive verbs:
  # blacklist:
  #   - "delete_*"
  #   - "force_push_branch"
